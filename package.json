{
  "name": "bobby-rider",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "bot": "esbuild tools/bot.ts --bundle --platform=node --outfile=node_modules/.cache/bot.cjs --log-level=warning && node node_modules/.cache/bot.cjs"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
